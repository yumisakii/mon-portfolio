---
interface Props {
  title: string;
  description: string;
  tags: string[];
  link?: string;
  github?: string;
}

const { title, description, tags, link, github, image } = Astro.props;
---
<article class="bg-slate-900/50 flex flex-col justify-between rounded-2xl border border-slate-800 hover:border-emerald-500/50 transition-all overflow-hidden group">
  {image && (
    <div class="h-48 overflow-hidden bg-slate-950 relative">
      <img 
        src={image} 
        alt={title} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80 group-hover:opacity-100" 
      />
    </div>
  )}
  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="text-xl font-bold mb-3 group-hover:text-emerald-400 transition-colors">{title}</h3>
      <p class="text-slate-400 mb-6 text-sm leading-relaxed">{description}</p>
      <div class="flex flex-wrap gap-2 text-xs font-mono text-emerald-300/70 mb-6">
        {tags.map((tag) => (
          <span class="bg-emerald-500/10 px-2 py-1 rounded">{tag}</span>
        ))}
      </div>
    </div>
    
    <div class="flex gap-4 text-sm font-medium pt-4 border-t border-slate-800/50">
      {link && <a href={link} target="_blank" rel="noopener noreferrer" class="text-slate-200 hover:text-emerald-400 transition-colors">Démo ↗</a>}
      {github && <a href={github} target="_blank" rel="noopener noreferrer" class="text-slate-200 hover:text-emerald-400 transition-colors">Code source ↗</a>}
    </div>
  </div>
</article>